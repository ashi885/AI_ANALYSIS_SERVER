# Server Port (Backend)
PORT=3001

# Development Port (Frontend)
VITE_PORT=3003

# NODE_ENV
NODE_ENV=development

# Database Configuration
# Priority: DB_PATH > DATA_DIR > [cwd]/data/management.db
# DB_PATH="C:/custom/path/to/management.db"
# DATA_DIR="./data"

# SUPABASE
SUPABASE_URL=your_url
SUPABASE_ANON_KEY=your_key

# ADMIN CREDENTIALS
ADMIN_EMAIL=admin
ADMIN_PASSWORD=cuepoint2025

# RATE LIMITING (change without rebuild, just restart)
# Global: applied to ALL API routes (safety net)
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=200
# Client-facing: applied to /clients/config, /credentials, /pricing, /validate, /heartbeat, /usage, /available-models, /provider-labels, /auth/token
RATE_LIMIT_CLIENT_WINDOW_MS=60000
RATE_LIMIT_CLIENT_MAX=40
