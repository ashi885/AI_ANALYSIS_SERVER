# CuePoint Server - Production .env
# Copy this file to .env on your server and fill in the values

# Data directory - SET THIS TO /data ON LINUX PRODUCTION
DATA_DIR=/data

# Encryption key (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=generate-a-32-character-hex-key-here

# Server Port (use 3001 or your preferred port)
PORT=3001

# Default API Keys (optional - fallback if client has no key)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
